# Pukico Dashboard Environment Configuration
# Note: Client-side variables start with VITE_

# VITE_PRIVY_APP_ID: Your Privy App ID from https://dashboard.privy.io
VITE_PRIVY_APP_ID=""

# VITE_SUPABASE_URL: Your Supabase project URL (e.g., https://your-project.supabase.co)
VITE_SUPABASE_URL=""

# VITE_SUPABASE_ANON_KEY: Your Supabase anon public API key
VITE_SUPABASE_ANON_KEY=""

# VITE_DEMO_MODE: Set to "true" to preview dashboard with mock data without live backend
VITE_DEMO_MODE="false"
